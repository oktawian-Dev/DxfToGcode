<Window x:Class="DxfToGcode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF → G-code"
        Height="760"
        Width="900"
        MinHeight="650"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />

                <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Generator G-code z DXF"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <GroupBox Grid.Row="2" Header="Plik źródłowy">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="DxfPathTextBox"
                             Grid.Row="0"
                             IsReadOnly="True"
                             Text="Nie wybrano pliku DXF" />

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Width="130"
                            Content="Wybierz DXF"
                            Click="SelectDxfButton_Click" />

                    <TextBlock x:Name="DxfInfoTextBlock"
                               Grid.Row="2"
                               Grid.ColumnSpan="3"
                               Text="Po wybraniu pliku tutaj pojawią się informacje o ścieżkach."
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="Przypisanie kolorów DXF">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               VerticalAlignment="Center"
                               Text="Klej zimny — T1 (niebieski):" />
                    <TextBox x:Name="ColdGlueColorTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="5" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="Klej ciepły — T2 (żółty):" />
                    <TextBox x:Name="HotGlueColorTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Text="2" />

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="Ramka ograniczająca (magenta):" />
                    <TextBox x:Name="FrameColorTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Text="230" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="6" Header="Kopie projektu">
                <StackPanel Margin="12">
                    <TextBlock Margin="0,0,0,10"
                               Text="Zaznacz układy, dla których ma zostać wygenerowany kod. Odbicie dotyczy środka ramki magenta." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="G54CheckBox"
                                  Grid.Row="0"
                                  Content="G54"
                                  IsChecked="True"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G54MirrorCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />

                        <CheckBox x:Name="G55CheckBox"
                                  Grid.Row="1"
                                  Content="G55"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G55MirrorCheckBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />

                        <CheckBox x:Name="G56CheckBox"
                                  Grid.Row="2"
                                  Content="G56"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G56MirrorCheckBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />

                        <CheckBox x:Name="G57CheckBox"
                                  Grid.Row="3"
                                  Content="G57"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G57MirrorCheckBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />

                        <CheckBox x:Name="G58CheckBox"
                                  Grid.Row="4"
                                  Content="G58"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G58MirrorCheckBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />

                        <CheckBox x:Name="G59CheckBox"
                                  Grid.Row="5"
                                  Content="G59"
                                  VerticalAlignment="Center" />
                        <CheckBox x:Name="G59MirrorCheckBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Content="Odbicie lustrzane"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Button Grid.Row="8"
                    Height="42"
                    Margin="0,20,0,0"
                    Content="Generuj plik G-code"
                    FontSize="16"
                    Click="GenerateGCodeButton_Click" />

            <GroupBox Grid.Row="10"
                      Margin="0,16,0,0"
                      Header="Podgląd wygenerowanego G-code">
                <TextBox x:Name="GCodePreviewTextBox"
                         Margin="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>